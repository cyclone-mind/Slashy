{
  "name": "slashy",
  "version": "0.1.4",
  "description": "Slash-command AI skills for Chrome's side panel. Bring your own model.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/cyclone-mind/Slashy.git" },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "type-check": "tsc --noEmit",
    "zip": "node build.mjs && node scripts/zip.mjs",
    "test": "node --experimental-strip-types --test src/*.test.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.323",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": { "node": ">=22" }
}
